# Copy to .env for local development; never commit .env.
APP_NAME=CajeerServers
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
# Generate a random 32+ byte key before setting APP_ENV=production:
# php -r 'echo "base64:", base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=
APP_LOCALE=ru

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeerservers
DB_USERNAME=cajeer
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Use Redis ACL and TLS for non-loopback production Redis connections.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CA_FILE=
REDIS_TIMEOUT=3
REDIS_CACHE_PREFIX=cajeer:cache:
REDIS_QUEUE_PREFIX=cajeer:queue:
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_NAME=default
QUEUE_LEASE_SECONDS=60
SCHEDULER_ENABLED=true
SCHEDULER_BATCH=25
STORAGE_DISK=local
# Keep local storage OUTSIDE the web root. Empty uses storage/files.
STORAGE_LOCAL_ROOT=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=
S3_ALLOW_LOCAL_HTTP=false
S3_TIMEOUT=10

PROMETHEUS_ENABLED=false
# Required for /api/v1/metrics: 32+ random characters; never expose over plain HTTP in production.
PROMETHEUS_SCRAPE_TOKEN=
OTEL_ENABLED=false
OTEL_SAMPLE_RATIO=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Vault 0.3.1: use ONE of the following; never use APP_KEY or legacy VAULT_KEY.
# For production, prefer a root-owned or PHP-service-owned private file (0600).
VAULT_MASTER_KEY=
VAULT_MASTER_KEY_FILE=
WEBHOOK_SIGNING_SECRET=
GITHUB_REGISTRY_URL=https://github.com/CajeerTeam/CajeerServers

# PostgreSQL TLS: use verify-full with a trusted CA for remote production servers.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ssl/certs/database-ca.pem
# DB_CONNECT_TIMEOUT=5
