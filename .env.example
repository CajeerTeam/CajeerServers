# Copy to .env for local development; never commit .env to GitFlic.
APP_NAME=CajeerServers
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
# Generate a random 32+ byte key before setting APP_ENV=production:
# php -r 'echo "base64:", base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=
APP_LOCALE=ru

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cajeerservers
DB_USERNAME=cajeer
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
STORAGE_DISK=local

PROMETHEUS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

VAULT_KEY=
WEBHOOK_SIGNING_SECRET=
GITFLIC_REGISTRY_URL=https://gitflic.ru/project/cajeer/registry

# PostgreSQL TLS: use verify-full with a trusted CA for remote production servers.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/etc/ssl/certs/database-ca.pem
# DB_CONNECT_TIMEOUT=5
