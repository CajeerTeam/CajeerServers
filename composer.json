{
  "name": "cajeer/cajeerservers",
  "description": "Russian-first API-first web control shell for infrastructure data collection and management.",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "symfony/http-foundation": "^7.0",
    "symfony/routing": "^7.0",
    "symfony/console": "^7.0",
    "symfony/yaml": "^7.0",
    "psr/log": "^3.0",
    "ext-openssl": "*",
    "ext-sodium": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Cajeer\\Servers\\": "core/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cajeer\\Servers\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "doctor": "php bin/cajeer doctor",
    "runtime:test": "@php tests/runtime-smoke.php",
    "runtime:doctor": "@php bin/cajeer doctor",
    "database:test": "@php tests/database-smoke.php",
    "auth:test": "@php tests/auth-smoke.php",
    "security:test": "@php tests/security-smoke.php",
    "security:postgres:test": "@php tests/security-postgres-integration.php",
    "infrastructure:test": "@php tests/infrastructure-smoke.php",
    "infrastructure:postgres:test": "@php tests/infrastructure-postgres-integration.php",
    "infrastructure:redis:test": "@php tests/infrastructure-redis-integration.php",
    "observability:test": "@php tests/observability-smoke.php",
    "admin:test": "@php tests/admin-smoke.php",
    "admin:postgres:test": "@php tests/admin-postgres-integration.php",
    "inventory:readiness:test": "@php tests/inventory-readiness-smoke.php",
    "inventory:postgres:test": "@php tests/inventory-postgres-integration.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "ext-pdo_pgsql": "Required for PostgreSQL 17+ persistence and SQL migrations",
    "ext-pdo_mysql": "Optional MySQL/MariaDB PDO connections (migration parity not yet available)"
  }
}
