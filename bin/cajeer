#!/usr/bin/env php
<?php
declare(strict_types=1);

use Cajeer\Servers\Cli\CommandRunner;

$app = null;
$exitCode = 1;
try {
    $app = require dirname(__DIR__) . '/core/bootstrap.php';
    $exitCode = (new CommandRunner($app))->run($argv);
} catch (Throwable $error) {
    error_log('CajeerServers: CLI bootstrap failure (' . $error::class . ').');
    fwrite(STDERR, "[ERROR] CLI bootstrap failed. Check .env syntax and runtime configuration.\n");
} finally {
    $app?->terminate();
}
exit($exitCode);
