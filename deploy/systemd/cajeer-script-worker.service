[Unit]
Description=CajeerServers isolated script worker (one job)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=cajeer-script
Group=cajeer-script
WorkingDirectory=/opt/cajeer
ExecStart=/usr/bin/php /opt/cajeer/bin/run-script.php 1
TimeoutStartSec=130
TimeoutStopSec=5
KillMode=control-group
MemoryMax=768M
MemorySwapMax=0
TasksMax=96
CPUQuota=100%
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/cajeer/storage
# User namespaces are intentionally required by bubblewrap. Do not disable them.
