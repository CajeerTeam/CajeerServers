[Unit]
Description=CajeerServers durable general queue worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cajeer
Group=cajeer
WorkingDirectory=/opt/cajeer
ExecStart=/usr/bin/php /opt/cajeer/bin/cajeer queue:work --queue=default --max-seconds=300 --max-jobs=100 --lease=120
Restart=always
RestartSec=5s
TimeoutStopSec=150s
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
